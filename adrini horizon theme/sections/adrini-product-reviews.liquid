{%- doc -%}
  ADRINI Luxury Product Reviews Section
  Fully responsive, real-data calculation, client & metafields compatible.
{%- enddoc -%}

{% liquid
  assign current_product = product | default: closest.product
  assign custom_reviews_metafield = current_product.metafields.custom.reviews.value
  assign current_variant = current_product.selected_or_first_available_variant
  assign variant_title = ''
  if current_variant and current_variant.title != 'Default Title'
    assign variant_title = current_variant.title
  endif
%}

<div
  class="adrini-reviews-section"
  id="adrini-reviews-{{ section.id }}"
  data-product-id="{{ current_product.id }}"
  data-product-title="{{ current_product.title | escape }}"
  data-variant-title="{{ variant_title | escape }}"
  {{ section.shopify_attributes }}
>
  <div class="adrini-reviews-container">
    
    <!-- Section Header -->
    <div class="adrini-reviews-header">
      <div class="adrini-reviews-eyebrow">{{ section.settings.subheading | default: 'CUSTOMER REVIEWS' }}</div>
      <h2 class="adrini-reviews-title">{{ section.settings.heading | default: 'Customer Reviews' }}</h2>
    </div>

    <!-- Main Reviews Content Wrapper -->
    <div class="adrini-reviews-content" id="adrini-reviews-content-{{ section.id }}">
      
      <!-- Summary Card (Visible only when real reviews exist) -->
      <div class="adrini-reviews-summary-card" id="adrini-summary-card-{{ section.id }}" style="display: none;">
        <!-- Left Column: Rating Breakdown -->
        <div class="adrini-summary-left">
          <div class="adrini-rating-score-row">
            <span class="adrini-score-number" id="adrini-avg-score-{{ section.id }}">0.0</span>
            <div class="adrini-score-meta">
              <div class="adrini-stars-display" id="adrini-avg-stars-{{ section.id }}" aria-label="Average rating">
                <!-- SVG stars injected dynamically -->
              </div>
              <div class="adrini-count-label" id="adrini-total-count-label-{{ section.id }}">Based on 0 reviews</div>
            </div>
          </div>

          <!-- Distribution Bars (5 Stars down to 1 Star) -->
          <div class="adrini-distribution-list" id="adrini-distribution-list-{{ section.id }}">
            {% for i in (1..5) reversed %}
              <div class="adrini-dist-row" data-star="{{ i }}">
                <span class="adrini-dist-label">{{ i }} ★</span>
                <div class="adrini-dist-track">
                  <div class="adrini-dist-fill" id="adrini-dist-bar-{{ i }}-{{ section.id }}" style="width: 0%;"></div>
                </div>
                <span class="adrini-dist-count" id="adrini-dist-count-{{ i }}-{{ section.id }}">0</span>
              </div>
            {% endfor %}
          </div>
        </div>

        <!-- Right Column: Recommendation, Trust & CTA -->
        <div class="adrini-summary-right">
          <div class="adrini-rec-block" id="adrini-rec-block-{{ section.id }}" style="display: none;">
            <div class="adrini-rec-badge" id="adrini-rec-badge-wrap-{{ section.id }}">
              <span class="adrini-rec-pct" id="adrini-rec-pct-{{ section.id }}">100%</span>
              <span class="adrini-rec-text">of customers recommend this saree</span>
            </div>
            <div class="adrini-trust-points" id="adrini-trust-points-{{ section.id }}">
              <span id="adrini-trust-verified-{{ section.id }}" style="display: none;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#651B24" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Verified Purchases
              </span>
              <span id="adrini-trust-genuine-{{ section.id }}">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#651B24" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Genuine Customer Feedback
              </span>
            </div>
          </div>

          <div class="adrini-summary-action">
            <button
              type="button"
              class="adrini-btn-write-review"
              onclick="window.openAdriniReviewModal('{{ section.id }}')"
              aria-label="Write a review"
            >
              WRITE A REVIEW
            </button>
          </div>
        </div>
      </div>

      <!-- Reviews Filters & Sort Toolbar -->
      <div class="adrini-reviews-toolbar" id="adrini-reviews-toolbar-{{ section.id }}" style="display: none;">
        <div class="adrini-toolbar-count" id="adrini-toolbar-count-{{ section.id }}">
          Showing reviews
        </div>
        <div class="adrini-toolbar-controls">
          <label class="adrini-filter-photo" id="adrini-photo-filter-wrap-{{ section.id }}" style="display: none;">
            <input type="checkbox" id="adrini-filter-photo-{{ section.id }}" onchange="window.filterAdriniReviews('{{ section.id }}')">
            <span>With photos</span>
          </label>
          <div class="adrini-sort-wrapper">
            <label for="adrini-sort-{{ section.id }}" class="visually-hidden">Sort reviews</label>
            <select id="adrini-sort-{{ section.id }}" class="adrini-sort-select" onchange="window.sortAdriniReviews('{{ section.id }}')">
              <option value="recent">MOST RECENT</option>
              <option value="highest">HIGHEST RATING</option>
              <option value="lowest">LOWEST RATING</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Reviews List Container -->
      <div class="adrini-reviews-list" id="adrini-reviews-list-{{ section.id }}">
        <!-- Individual review cards rendered dynamically from real data -->
      </div>

      <!-- Load More Reviews Button Container -->
      <div class="adrini-load-more-wrap" id="adrini-load-more-wrap-{{ section.id }}" style="display: none;">
        <button
          type="button"
          class="adrini-btn-load-more"
          id="adrini-btn-load-more-{{ section.id }}"
          onclick="window.loadMoreAdriniReviews('{{ section.id }}')"
        >
          LOAD MORE REVIEWS
        </button>
      </div>

      <!-- Empty State Container (When zero reviews exist) -->
      <div class="adrini-reviews-empty" id="adrini-reviews-empty-{{ section.id }}" style="display: none;">
        <div class="adrini-empty-icon">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#651B24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
        </div>
        <h3 class="adrini-empty-title">No reviews yet</h3>
        <p class="adrini-empty-desc">Be the first to share your experience with this saree.</p>
        <button
          type="button"
          class="adrini-btn-write-review adrini-btn-write-first"
          onclick="window.openAdriniReviewModal('{{ section.id }}')"
        >
          WRITE THE FIRST REVIEW
        </button>
      </div>

    </div>

  </div>
</div>

<!-- ======================================================
     WRITE A REVIEW MODAL
====================================================== -->
<div
  id="adrini-review-modal-{{ section.id }}"
  class="adrini-review-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="adrini-modal-title-{{ section.id }}"
  style="display: none;"
>
  <div class="adrini-modal-backdrop" onclick="window.closeAdriniReviewModal('{{ section.id }}')"></div>
  <div class="adrini-modal-dialog">
    <div class="adrini-modal-header">
      <div>
        <h3 class="adrini-modal-title" id="adrini-modal-title-{{ section.id }}">Write a Review</h3>
        <div class="adrini-modal-subtitle">{{ current_product.title | escape }}</div>
      </div>
      <button
        type="button"
        class="adrini-modal-close"
        onclick="window.closeAdriniReviewModal('{{ section.id }}')"
        aria-label="Close modal"
      >
        &times;
      </button>
    </div>

    <!-- Inline Form Validation Alert -->
    <div class="adrini-form-alert" id="adrini-form-alert-{{ section.id }}" style="display: none;" role="alert"></div>

    <form id="adrini-review-form-{{ section.id }}" class="adrini-review-form" onsubmit="window.handleAdriniReviewSubmit(event, '{{ section.id }}')" novalidate>
      <!-- Star Rating Input (Default 0 stars selected) -->
      <div class="adrini-form-group">
        <label class="adrini-form-label">Your Overall Rating <span class="adrini-required">*</span></label>
        <div
          class="adrini-star-picker"
          id="adrini-star-picker-{{ section.id }}"
          onmouseleave="window.resetAdriniRatingPreview('{{ section.id }}')"
        >
          {% for star in (1..5) %}
            <button
              type="button"
              class="adrini-star-pick-btn"
              data-rating="{{ star }}"
              onmouseenter="window.previewAdriniRating('{{ section.id }}', {{ star }})"
              onclick="window.setAdriniRating('{{ section.id }}', {{ star }})"
              aria-label="{{ star }} star{% if star > 1 %}s{% endif %}"
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C8BDC0" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
            </button>
          {% endfor %}
          <span class="adrini-rating-text" id="adrini-rating-text-{{ section.id }}"></span>
        </div>
        <input type="hidden" id="adrini-input-rating-{{ section.id }}" name="rating" value="0" required>
      </div>

      <!-- Review Title -->
      <div class="adrini-form-group">
        <label for="adrini-input-title-{{ section.id }}" class="adrini-form-label">Review Title <span class="adrini-required">*</span></label>
        <input
          type="text"
          id="adrini-input-title-{{ section.id }}"
          name="title"
          class="adrini-form-input"
          placeholder="e.g. Beautiful saree, loved the fabric!"
          required
          minlength="2"
        >
      </div>

      <!-- Review Details -->
      <div class="adrini-form-group">
        <label for="adrini-input-body-{{ section.id }}" class="adrini-form-label">Review Details <span class="adrini-required">*</span></label>
        <textarea
          id="adrini-input-body-{{ section.id }}"
          name="body"
          class="adrini-form-textarea"
          rows="4"
          placeholder="Share your thoughts on the drape, color, zari finish, and packaging..."
          required
          minlength="5"
        ></textarea>
      </div>

      <!-- Author Name & Email (Row) -->
      <div class="adrini-form-row">
        <div class="adrini-form-group">
          <label for="adrini-input-name-{{ section.id }}" class="adrini-form-label">Your Name <span class="adrini-required">*</span></label>
          <input
            type="text"
            id="adrini-input-name-{{ section.id }}"
            name="author"
            class="adrini-form-input"
            placeholder="e.g. Priya Sharma"
            required
            minlength="2"
          >
        </div>
        <div class="adrini-form-group">
          <label for="adrini-input-email-{{ section.id }}" class="adrini-form-label">Email Address <span class="adrini-subdued">(Private)</span></label>
          <input
            type="email"
            id="adrini-input-email-{{ section.id }}"
            name="email"
            class="adrini-form-input"
            placeholder="For review verification"
          >
        </div>
      </div>

      <!-- Optional Photo Upload -->
      <div class="adrini-form-group">
        <label class="adrini-form-label">Add a Photo <span class="adrini-subdued">(Optional)</span></label>
        <div class="adrini-file-upload-wrap">
          <input
            type="file"
            id="adrini-input-photo-{{ section.id }}"
            accept="image/*"
            class="adrini-file-input"
            onchange="window.handleAdriniPhotoSelect(event, '{{ section.id }}')"
          >
          <div class="adrini-file-upload-box" id="adrini-upload-box-{{ section.id }}">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#756A6C" stroke-width="1.8">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
            <span id="adrini-upload-text-{{ section.id }}">Upload a photo of your saree</span>
          </div>
          <div class="adrini-photo-preview" id="adrini-photo-preview-{{ section.id }}" style="display: none;">
            <img id="adrini-preview-img-{{ section.id }}" src="" alt="Preview">
            <button type="button" class="adrini-photo-remove" onclick="window.removeAdriniPhoto('{{ section.id }}')" aria-label="Remove photo">&times;</button>
          </div>
        </div>
      </div>

      <!-- Form Actions -->
      <div class="adrini-modal-footer">
        <button type="button" class="adrini-btn-cancel" onclick="window.closeAdriniReviewModal('{{ section.id }}')">
          Cancel
        </button>
        <button type="submit" class="adrini-btn-submit" id="adrini-btn-submit-{{ section.id }}">
          SUBMIT REVIEW
        </button>
      </div>
    </form>

    <!-- Success Screen -->
    <div id="adrini-modal-success-{{ section.id }}" class="adrini-modal-success" style="display: none;">
      <div class="adrini-success-check">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#651B24" stroke-width="2.5">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <h4 class="adrini-success-title">Thank You For Your Review!</h4>
      <p class="adrini-success-desc">Your review has been submitted. Thank you for sharing your experience with fellow saree connoisseurs.</p>
      <button type="button" class="adrini-btn-submit" onclick="window.closeAdriniReviewModal('{{ section.id }}')">
        Close
      </button>
    </div>
  </div>
</div>

<!-- ======================================================
     IMAGE LIGHTBOX MODAL
====================================================== -->
<div id="adrini-reviews-lightbox" class="adrini-reviews-lightbox" style="display: none;" onclick="window.closeAdriniLightbox()">
  <button type="button" class="adrini-lightbox-close" onclick="window.closeAdriniLightbox()" aria-label="Close enlarged photo">&times;</button>
  <img id="adrini-lightbox-img" src="" alt="Enlarged review photo" onclick="event.stopPropagation()">
</div>

<!-- Server-side JSON data bridge (reads product metafields) -->
<script type="application/json" id="adrini-initial-reviews-{{ section.id }}">
  {% liquid
    assign parsed_reviews = '[]'
    if custom_reviews_metafield != blank
      assign parsed_reviews = custom_reviews_metafield | json
    endif
  %}
  {{ parsed_reviews }}
</script>

<style>
/* ======================================================
   ADRINI LUXURY PRODUCT REVIEWS STYLES
====================================================== */
.adrini-reviews-section {
  width: 100%;
  background: #FFFFFF;
  border-top: 1px solid #EDE1E3;
  padding: 64px 40px;
  box-sizing: border-box;
  font-family: var(--font-body--family, "Inter"), sans-serif;
  color: #1A1208;
}

.adrini-reviews-container {
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
  box-sizing: border-box;
}

/* Header */
.adrini-reviews-header {
  text-align: center;
  margin-bottom: 40px;
}

.adrini-reviews-eyebrow {
  font-family: var(--font-body--family, "Inter"), sans-serif;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #651B24;
  margin-bottom: 8px;
}

.adrini-reviews-title {
  font-family: var(--font-heading-family, "Cormorant Garamond"), "Playfair Display", serif;
  font-size: 38px;
  font-weight: 400;
  color: #1A1208;
  line-height: 1.15;
  margin: 0;
}

/* Summary Card */
.adrini-reviews-summary-card {
  background: #FAF8F8;
  border: 1px solid #EDE1E3;
  border-radius: 8px;
  padding: 28px 32px;
  margin-bottom: 32px;
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 40px;
  align-items: center;
  box-sizing: border-box;
}

.adrini-summary-left {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding-right: 20px;
  border-right: 1px solid #EDE1E3;
  box-sizing: border-box;
}

.adrini-rating-score-row {
  display: flex;
  align-items: center;
  gap: 16px;
}

.adrini-score-number {
  font-family: var(--font-heading-family, "Cormorant Garamond"), serif;
  font-size: 52px;
  font-weight: 600;
  color: #1A1208;
  line-height: 1;
}

.adrini-score-meta {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.adrini-stars-display {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  color: #651B24;
}

.adrini-stars-display svg {
  width: 17px;
  height: 17px;
}

.adrini-count-label {
  font-size: 13px;
  color: #756A6C;
  font-weight: 500;
}

/* Distribution Bars */
.adrini-distribution-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
  width: 100%;
  max-width: 380px;
}

.adrini-dist-row {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 12px;
  color: #554B46;
}

.adrini-dist-label {
  width: 32px;
  font-weight: 600;
  white-space: nowrap;
}

.adrini-dist-track {
  flex: 1;
  height: 6px;
  background: #EAE2E4;
  border-radius: 3px;
  overflow: hidden;
  position: relative;
}

.adrini-dist-fill {
  height: 100%;
  background: #651B24;
  border-radius: 3px;
  transition: width 0.4s ease;
}

.adrini-dist-count {
  width: 24px;
  text-align: right;
  font-size: 12px;
  color: #756A6C;
}

/* Summary Right */
.adrini-summary-right {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  gap: 20px;
  padding-left: 10px;
  box-sizing: border-box;
}

.adrini-rec-block {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.adrini-rec-badge {
  display: flex;
  align-items: baseline;
  gap: 8px;
}

.adrini-rec-pct {
  font-family: var(--font-heading-family, "Cormorant Garamond"), serif;
  font-size: 32px;
  font-weight: 600;
  color: #651B24;
  line-height: 1;
}

.adrini-rec-text {
  font-size: 13.5px;
  color: #1A1208;
  font-weight: 500;
}

.adrini-trust-points {
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 12px;
  color: #756A6C;
}

.adrini-trust-points span {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.adrini-btn-write-review {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #651B24;
  color: #FFFFFF;
  border: 1px solid #651B24;
  border-radius: 6px;
  padding: 12px 28px;
  font-family: var(--font-body--family, "Inter"), sans-serif;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  cursor: pointer;
  transition: all 0.2s ease;
  box-shadow: 0 2px 8px rgba(101, 27, 36, 0.15);
  box-sizing: border-box;
}

.adrini-btn-write-review:hover {
  background: #4A121A;
  border-color: #4A121A;
  transform: translateY(-1px);
  box-shadow: 0 4px 14px rgba(101, 27, 36, 0.22);
}

/* Toolbar & Filters */
.adrini-reviews-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16px;
  border-bottom: 1px solid #EDE1E3;
  margin-bottom: 8px;
  box-sizing: border-box;
}

.adrini-toolbar-count {
  font-size: 13px;
  font-weight: 500;
  color: #756A6C;
}

.adrini-toolbar-controls {
  display: flex;
  align-items: center;
  gap: 16px;
}

.adrini-filter-photo {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12.5px;
  color: #1A1208;
  cursor: pointer;
  user-select: none;
}

.adrini-filter-photo input {
  accent-color: #651B24;
  cursor: pointer;
}

.adrini-sort-select {
  background: #FFFFFF;
  border: 1px solid #EDE1E3;
  border-radius: 4px;
  padding: 6px 12px;
  font-size: 11.5px;
  font-weight: 600;
  color: #1A1208;
  letter-spacing: 0.05em;
  outline: none;
  cursor: pointer;
}

/* Reviews List */
.adrini-reviews-list {
  display: flex;
  flex-direction: column;
}

.adrini-review-card {
  padding: 24px 0;
  border-bottom: 1px solid #EDE1E3;
  display: flex;
  flex-direction: column;
  gap: 10px;
  box-sizing: border-box;
}

.adrini-review-card:last-child {
  border-bottom: none;
}

.adrini-review-top {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12px;
}

.adrini-review-stars {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  color: #651B24;
}

.adrini-review-stars svg {
  width: 15px;
  height: 15px;
}

.adrini-review-title {
  font-size: 15px;
  font-weight: 600;
  color: #1A1208;
  margin: 0;
  line-height: 1.3;
}

.adrini-review-body {
  font-size: 13.5px;
  line-height: 1.6;
  color: #4A3E3D;
  margin: 0;
}

.adrini-review-author-row {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  margin-top: 2px;
  flex-wrap: wrap;
  color: #756A6C;
}

.adrini-review-author {
  font-weight: 600;
  color: #1A1208;
}

.adrini-review-sep {
  color: #C8BDC0;
  font-size: 11px;
  line-height: 1;
  user-select: none;
}

.adrini-verified-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: #FAF4EB;
  color: #651B24;
  border: 1px solid #F0E3D2;
  border-radius: 12px;
  padding: 2px 7px;
  font-size: 10.5px;
  font-weight: 500;
}

.adrini-review-date {
  font-size: 12px;
  color: #8A7D6B;
}

.adrini-review-variant {
  font-size: 11px;
  color: #8A7D6B;
}

.adrini-review-photos-wrap {
  display: flex;
  gap: 10px;
  margin-top: 4px;
}

.adrini-thumb-container {
  position: relative;
  display: inline-block;
  cursor: pointer;
  border-radius: 4px;
  overflow: hidden;
}

.adrini-review-thumb {
  width: 68px;
  height: 68px;
  object-fit: cover;
  border: 1px solid #EDE1E3;
