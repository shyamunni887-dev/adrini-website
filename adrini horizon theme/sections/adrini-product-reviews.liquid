{% comment %}
  ADRINI Luxury Product Reviews Section
  Powered by Judge.me Product Reviews with custom ADRINI luxury styling.
{% endcomment %}

{% liquid
  assign current_product = product | default: closest.product
%}

<div
  class="adrini-reviews-section"
  id="adrini-reviews-{{ section.id }}"
  data-section-id="{{ section.id }}"
  {% if current_product != blank %}
    data-product-id="{{ current_product.id }}"
    data-product-title="{{ current_product.title | escape }}"
  {% endif %}
  {{ section.shopify_attributes }}
>
  <div class="adrini-reviews-container">
    <!-- ADRINI Luxury Section Header -->
    <div class="adrini-reviews-header">
      <div class="adrini-reviews-eyebrow">{{ section.settings.subheading | default: 'CUSTOMER REVIEWS' }}</div>
      <h2 class="adrini-reviews-title">{{ section.settings.heading | default: 'Customer Reviews' }}</h2>
    </div>

    <!-- Official Judge.me Product Reviews Widget Container -->
    {% if current_product != blank %}
      <div
        id="judgeme_product_reviews"
        class="jdgm-widget jdgm-review-widget"
        data-product-title="{{ current_product.title | escape }}"
        data-id="{{ current_product.id }}"
      >
        {{ current_product.metafields.judgeme.widget }}
      </div>
    {% endif %}
  </div>
</div>

<style>
/* ============================================================
   ADRINI LUXURY DESIGN SKIN FOR JUDGE.ME PRODUCT REVIEWS
   Scoped strictly to .adrini-reviews-section
   ============================================================ */

.adrini-reviews-section {
  width: 100%;
  background: #FFFFFF;
  padding: 60px 0 80px 0;
  border-top: 1px solid #EDE1E3;
  position: relative;
  font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif;
  color: #1A1208;
  box-sizing: border-box;
}

.adrini-reviews-section * {
  box-sizing: border-box;
}

.adrini-reviews-section .adrini-reviews-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
}

/* Header */
.adrini-reviews-section .adrini-reviews-header {
  text-align: center;
  margin-bottom: 36px;
}

.adrini-reviews-section .adrini-reviews-eyebrow {
  font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: #651B24;
  margin-bottom: 8px;
}

.adrini-reviews-section .adrini-reviews-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: 36px;
  font-weight: 400;
  letter-spacing: 0.02em;
  color: #1A1208;
  margin: 0;
  line-height: 1.2;
}

/* Hide duplicate internal Judge.me title if section header exists */
.adrini-reviews-section .jdgm-rev-widg__title {
  display: none !important;
}

/* ============================================================
   JUDGE.ME CORE WIDGET CUSTOMIZATION
   ============================================================ */

.adrini-reviews-section .jdgm-widget {
  max-width: 100% !important;
  font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif !important;
  color: #1A1208 !important;
}

.adrini-reviews-section .jdgm-rev-widg {
  border: none !important;
  padding: 0 !important;
  margin: 0 !important;
  background: transparent !important;
}

/* ------------------------------------------------------------
   Summary Header Card
   ------------------------------------------------------------ */
.adrini-reviews-section .jdgm-rev-widg__header {
  background: #FAF8F8 !important;
  border: 1px solid #EDE1E3 !important;
  border-radius: 8px !important;
  padding: 28px 32px !important;
  margin-bottom: 32px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  flex-wrap: wrap !important;
  gap: 24px !important;
  box-shadow: none !important;
}

.adrini-reviews-section .jdgm-rev-widg__summary {
  display: flex !important;
  align-items: center !important;
  gap: 16px !important;
  flex-wrap: wrap !important;
}

.adrini-reviews-section .jdgm-rev-widg__summary-average {
  font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif !important;
  font-size: 36px !important;
  font-weight: 700 !important;
  color: #651B24 !important;
  line-height: 1 !important;
}

.adrini-reviews-section .jdgm-rev-widg__summary-text {
  font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif !important;
  font-size: 13px !important;
  color: #665E5E !important;
  margin-top: 2px !important;
}

/* ------------------------------------------------------------
   Stars
   ------------------------------------------------------------ */
.adrini-reviews-section .jdgm-star {
  color: #651B24 !important;
  font-size: 15px !important;
  padding-right: 2px !important;
}

.adrini-reviews-section .jdgm-star.jdgm--on {
  color: #651B24 !important;
}

.adrini-reviews-section .jdgm-star.jdgm--half {
  color: #651B24 !important;
}

.adrini-reviews-section .jdgm-star.jdgm--off {
  color: #EAE2E4 !important;
}

/* ------------------------------------------------------------
   Histogram (Rating breakdown bars)
   ------------------------------------------------------------ */
.adrini-reviews-section .jdgm-histogram {
  max-width: 320px !important;
  margin: 0 !important;
}

.adrini-reviews-section .jdgm-histogram__row {
  display: flex !important;
  align-items: center !important;
  gap: 10px !important;
  font-size: 12px !important;
  color: #665E5E !important;
  line-height: 1.8 !important;
}

.adrini-reviews-section .jdgm-histogram__star {
  color: #651B24 !important;
  font-size: 13px !important;
}

.adrini-reviews-section .jdgm-histogram__bar {
  background: #EAE2E4 !important;
  height: 6px !important;
  border-radius: 3px !important;
  flex: 1 !important;
  overflow: hidden !important;
}

.adrini-reviews-section .jdgm-histogram__bar-content {
  background: #651B24 !important;
  border-radius: 3px !important;
  height: 100% !important;
}

.adrini-reviews-section .jdgm-histogram__frequency {
  font-size: 12px !important;
  color: #665E5E !important;
  min-width: 24px !important;
  text-align: right !important;
}

/* ------------------------------------------------------------
   Buttons & CTAs
   ------------------------------------------------------------ */
.adrini-reviews-section .jdgm-write-rev-link,
.adrini-reviews-section .jdgm-btn,
.adrini-reviews-section .jdgm-submit-rev {
  background: #651B24 !important;
  color: #FFFFFF !important;
  font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif !important;
  font-size: 12px !important;
  font-weight: 600 !important;
  letter-spacing: 0.08em !important;
  text-transform: uppercase !important;
  padding: 13px 26px !important;
  border-radius: 4px !important;
  border: 1px solid #651B24 !important;
  transition: all 0.25s ease !important;
  text-decoration: none !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  cursor: pointer !important;
  box-shadow: none !important;
  line-height: 1.2 !important;
}

.adrini-reviews-section .jdgm-write-rev-link:hover,
.adrini-reviews-section .jdgm-btn:hover,
.adrini-reviews-section .jdgm-submit-rev:hover {
  background: #4A121A !important;
  border-color: #4A121A !important;
  color: #FFFFFF !important;
  transform: translateY(-1px) !important;
}

/* ------------------------------------------------------------
   Toolbar: Sorting & Filtering
   ------------------------------------------------------------ */
.adrini-reviews-section .jdgm-sort-dropdown-wrapper,
.adrini-reviews-section .jdgm-filter-dropdown-wrapper {
  margin-bottom: 20px !important;
}

.adrini-reviews-section .jdgm-sort-dropdown,
.adrini-reviews-section .jdgm-filter-dropdown,
.adrini-reviews-section select.jdgm-sort-dropdown {
  font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif !important;
  font-size: 12px !important;
  font-weight: 500 !important;
  color: #1A1208 !important;
  border: 1px solid #EDE1E3 !important;
  border-radius: 4px !important;
  padding: 8px 14px !important;
  background-color: #FFFFFF !important;
  outline: none !important;
  cursor: pointer !important;
}

.adrini-reviews-section .jdgm-sort-dropdown:focus,
.adrini-reviews-section select.jdgm-sort-dropdown:focus {
  border-color: #651B24 !important;
}

/* ------------------------------------------------------------
   Review Cards & List
   ------------------------------------------------------------ */
.adrini-reviews-section .jdgm-rev-widg__reviews {
  display: flex !important;
  flex-direction: column !important;
  gap: 16px !important;
  margin-top: 24px !important;
}

.adrini-reviews-section .jdgm-rev {
  background: #FFFFFF !important;
  border: 1px solid #EDE1E3 !important;
  border-radius: 8px !important;
  padding: 22px 24px !important;
  margin: 0 !important;
  box-shadow: none !important;
  transition: border-color 0.2s ease, box-shadow 0.2s ease !important;
}

.adrini-reviews-section .jdgm-rev:hover {
  border-color: #D6C8CA !important;
  box-shadow: 0 4px 16px rgba(101, 27, 36, 0.04) !important;
}

.adrini-reviews-section .jdgm-rev__header {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  flex-wrap: wrap !important;
  gap: 10px !important;
  margin-bottom: 12px !important;
}

.adrini-reviews-section .jdgm-rev__rating {
  margin-right: 10px !important;
}

.adrini-reviews-section .jdgm-rev__author-wrapper {
  display: inline-flex !important;
  align-items: center !important;
  gap: 8px !important;
  flex-wrap: wrap !important;
}

.adrini-reviews-section .jdgm-rev__author {
  font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif !important;
  font-weight: 600 !important;
  font-size: 14px !important;
  color: #1A1208 !important;
}

/* Verified Buyer Badge */
.adrini-reviews-section .jdgm-rev__buyer-badge {
  background: #FAF4EB !important;
  color: #651B24 !important;
  border: 1px solid #F0E3D2 !important;
  font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif !important;
  font-size: 10px !important;
  font-weight: 600 !important;
  text-transform: uppercase !important;
  letter-spacing: 0.06em !important;
  padding: 3px 8px !important;
  border-radius: 20px !important;
  display: inline-flex !important;
  align-items: center !important;
  gap: 4px !important;
  margin-left: 6px !important;
}

.adrini-reviews-section .jdgm-rev__timestamp {
  font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif !important;
  font-size: 12px !important;
  color: #665E5E !important;
}

/* Review Title */
.adrini-reviews-section .jdgm-rev__title {
  font-family: 'Cormorant Garamond', Georgia, serif !important;
  font-size: 20px !important;
  font-weight: 600 !important;
  color: #1A1208 !important;
  margin: 10px 0 8px 0 !important;
  line-height: 1.3 !important;
}

/* Review Body */
.adrini-reviews-section .jdgm-rev__body {
  font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif !important;
  font-size: 14px !important;
  line-height: 1.65 !important;
  color: #4A4242 !important;
  margin-top: 4px !important;
}

/* Review Photos */
.adrini-reviews-section .jdgm-rev__pics {
  display: flex !important;
  gap: 10px !important;
  margin-top: 14px !important;
  flex-wrap: wrap !important;
}

.adrini-reviews-section .jdgm-rev__pic-link,
.adrini-reviews-section .jdgm-rev__pic-img {
  border-radius: 6px !important;
  border: 1px solid #EDE1E3 !important;
  width: 72px !important;
  height: 72px !important;
  object-fit: cover !important;
  cursor: pointer !important;
  transition: transform 0.2s ease, border-color 0.2s ease !important;
}

.adrini-reviews-section .jdgm-rev__pic-link:hover .jdgm-rev__pic-img {
  transform: scale(1.04) !important;
  border-color: #651B24 !important;
}

/* ------------------------------------------------------------
   Pagination / Load More
   ------------------------------------------------------------ */
.adrini-reviews-section .jdgm-paginate {
  text-align: center !important;
  margin-top: 36px !important;
}

.adrini-reviews-section .jdgm-paginate__load-more,
.adrini-reviews-section a.jdgm-paginate__load-more {
  border: 1.5px solid #651B24 !important;
  color: #651B24 !important;
  background: #FFFFFF !important;
  font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif !important;
  font-size: 11px !important;
  font-weight: 600 !important;
  text-transform: uppercase !important;
  letter-spacing: 0.1em !important;
  padding: 13px 32px !important;
  border-radius: 4px !important;
  transition: all 0.25s ease !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  text-decoration: none !important;
  cursor: pointer !important;
}

.adrini-reviews-section .jdgm-paginate__load-more:hover,
.adrini-reviews-section a.jdgm-paginate__load-more:hover {
  background: #651B24 !important;
  color: #FFFFFF !important;
}

.adrini-reviews-section .jdgm-paginate__page {
  font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif !important;
  color: #651B24 !important;
  border: 1px solid #EDE1E3 !important;
  padding: 6px 12px !important;
  border-radius: 4px !important;
  margin: 0 4px !important;
  text-decoration: none !important;
}

.adrini-reviews-section .jdgm-paginate__page.jdgm-cur,
.adrini-reviews-section .jdgm-paginate__page:hover {
  background: #651B24 !important;
  color: #FFFFFF !important;
  border-color: #651B24 !important;
}

/* ------------------------------------------------------------
   Review Submission Form & Modal
   ------------------------------------------------------------ */
.adrini-reviews-section .jdgm-form-wrapper,
.adrini-reviews-section .jdgm-form {
  background: #FAF8F8 !important;
  border: 1px solid #EDE1E3 !important;
  border-radius: 8px !important;
  padding: 28px 32px !important;
  margin: 24px 0 !important;
  box-shadow: none !important;
}

.adrini-reviews-section .jdgm-form__title {
  font-family: 'Cormorant Garamond', Georgia, serif !important;
  font-size: 26px !important;
  font-weight: 400 !important;
  color: #1A1208 !important;
  margin-bottom: 20px !important;
}

.adrini-reviews-section .jdgm-form fieldset {
  border: none !important;
  padding: 0 !important;
  margin: 0 0 16px 0 !important;
}

.adrini-reviews-section .jdgm-form label {
  font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif !important;
  font-size: 11px !important;
  font-weight: 600 !important;
  text-transform: uppercase !important;
  letter-spacing: 0.06em !important;
  color: #1A1208 !important;
  margin-bottom: 6px !important;
  display: block !important;
}

.adrini-reviews-section .jdgm-form input[type="text"],
.adrini-reviews-section .jdgm-form input[type="email"],
.adrini-reviews-section .jdgm-form textarea {
  font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif !important;
  font-size: 14px !important;
  border: 1px solid #EDE1E3 !important;
  border-radius: 4px !important;
  padding: 10px 14px !important;
  background: #FFFFFF !important;
  color: #1A1208 !important;
  width: 100% !important;
  outline: none !important;
  transition: border-color 0.2s ease !important;
}

.adrini-reviews-section .jdgm-form input[type="text"]:focus,
.adrini-reviews-section .jdgm-form input[type="email"]:focus,
.adrini-reviews-section .jdgm-form textarea:focus {
  border-color: #651B24 !important;
}

.adrini-reviews-section .jdgm-cancel-rev {
  font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif !important;
  font-size: 12px !important;
  font-weight: 500 !important;
  color: #665E5E !important;
  text-decoration: underline !important;
  margin-left: 16px !important;
  cursor: pointer !important;
}

/* ------------------------------------------------------------
   Empty State
   ------------------------------------------------------------ */
.adrini-reviews-section .jdgm-rev-widg--empty .jdgm-rev-widg__summary-text {
  font-size: 14px !important;
  color: #665E5E !important;
  margin-bottom: 12px !important;
}

/* ------------------------------------------------------------
   Responsive Breakpoints (Mobile First)
   320px, 360px, 390px, 430px, Tablet, Desktop
   ------------------------------------------------------------ */
@media (max-width: 768px) {
  .adrini-reviews-section {
    padding: 40px 0 60px 0;
  }

  .adrini-reviews-section .adrini-reviews-container {
    padding: 0 16px;
  }

  .adrini-reviews-section .adrini-reviews-title {
    font-size: 28px;
  }

  .adrini-reviews-section .jdgm-rev-widg__header {
    flex-direction: column !important;
    align-items: center !important;
    text-align: center !important;
    padding: 20px 16px !important;
    gap: 16px !important;
  }

  .adrini-reviews-section .jdgm-rev-widg__summary {
    flex-direction: column !important;
    gap: 8px !important;
  }

  .adrini-reviews-section .jdgm-rev-widg__actions {
    width: 100% !important;
  }

  .adrini-reviews-section .jdgm-write-rev-link {
    width: 100% !important;
  }

  .adrini-reviews-section .jdgm-rev {
    padding: 16px 16px !important;
  }

  .adrini-reviews-section .jdgm-rev__header {
    flex-direction: column !important;
    align-items: flex-start !important;
    gap: 6px !important;
  }

  .adrini-reviews-section .jdgm-form-wrapper,
  .adrini-reviews-section .jdgm-form {
    padding: 20px 16px !important;
  }

  /* Prevent auto-zoom on iOS inputs */
  .adrini-reviews-section .jdgm-form input[type="text"],
  .adrini-reviews-section .jdgm-form input[type="email"],
  .adrini-reviews-section .jdgm-form textarea {
    font-size: 16px !important;
  }

  .adrini-reviews-section .jdgm-paginate__load-more,
  .adrini-reviews-section a.jdgm-paginate__load-more {
    width: 100% !important;
  }
}

@media (max-width: 430px) {
  .adrini-reviews-section .adrini-reviews-title {
    font-size: 25px;
  }

  .adrini-reviews-section .jdgm-rev-widg__summary-average {
    font-size: 30px !important;
  }

  .adrini-reviews-section .jdgm-rev__title {
    font-size: 18px !important;
  }
}
</style>

{% schema %}
{
  "name": "Product Reviews",
  "tag": "section",
  "class": "adrini-reviews-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Reviews"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "CUSTOMER REVIEWS"
    }
  ],
  "presets": [
    {
      "name": "Product Reviews"
    }
  ]
}
{% endschema %}
