{% comment %}
  ADRINI Luxury Product Reviews Section
  Powered by Judge.me Product Reviews with custom ADRINI luxury styling.
{% endcomment %}

{% liquid
  assign current_product = product | default: closest.product
%}

<div
  class="adrini-reviews-section"
  id="adrini-reviews-{{ section.id }}"
  data-section-id="{{ section.id }}"
  {% if current_product != blank %}
    data-product-id="{{ current_product.id }}"
    data-product-title="{{ current_product.title | escape }}"
  {% endif %}
  {{ section.shopify_attributes }}
>
  <div class="adrini-reviews-container">
    <!-- ADRINI Luxury Section Header (Single heading) -->
    <div class="adrini-reviews-header">
      <div class="adrini-reviews-eyebrow">{{ section.settings.subheading | default: 'CUSTOMER REVIEWS' }}</div>
      <h2 class="adrini-reviews-title">{{ section.settings.heading | default: 'Customer Reviews' }}</h2>
    </div>

    <!-- Official Judge.me Product Reviews Widget Container -->
    {% if current_product != blank %}
      <div
        id="judgeme_product_reviews"
        class="jdgm-widget jdgm-review-widget"
        data-widget="review"
        data-entry-point="review_widget.js"
        data-entry-key="review-widget/main.js"
        data-product-id="{{ current_product.id }}"
        data-id="{{ current_product.id }}"
        data-product-title="{{ current_product.title | escape }}"
        data-product-handle="{{ current_product.handle | escape }}"
        data-auto-install="false"
        data-shop-reviews-count="{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}"
      >
        {{ current_product.metafields.judgeme.widget }}
        <div class="adrini-reviews-loading" id="adrini-reviews-loading-{{ section.id }}">
          <span class="adrini-spin-dot"></span>
          <span class="adrini-loading-text">Loading reviews...</span>
        </div>
      </div>
    {% endif %}
  </div>
</div>

<script>
  window.jdgm = window.jdgm || {};
  window.jdgm.isVersion3 = true;
</script>
<link rel="stylesheet" href="https://cdnwidget.judge.me/widget_v3/form.css" media="all">

<script>
/* ============================================================
   ADRINI Judge.me Initialization Observer & Lifecycle Handler
   Guarantees Judge.me Revamp/Classic mounts without blank space
   ============================================================ */
(function() {
  var sectionId = '{{ section.id }}';
  var container = document.getElementById('judgeme_product_reviews');
  if (!container) return;

  var loader = document.getElementById('adrini-reviews-loading-' + sectionId);

  function isMounted() {
    var hasRevamp = container.querySelector('.jm-review-widget');
    var hasClassic = container.querySelector('.jdgm-rev-widg');
    if (hasRevamp || hasClassic) {
      if (loader && loader.parentNode) loader.remove();
      return true;
    }
    return false;
  }

  // Check immediately
  if (isMounted()) return;

  // MutationObserver to clean loading state as soon as Judge.me injects elements
  if (window.MutationObserver) {
    var observer = new MutationObserver(function(mutations, obs) {
      if (isMounted()) {
        obs.disconnect();
      }
    });
    observer.observe(container, { childList: true, subtree: true });
  }

  // Ensure Revamp entry point module is loaded if header script didn't trigger
  function ensureWidgetInit() {
    if (isMounted()) return;

    var baseUrl = (window.jdgm && window.jdgm.CDN_BASE_URL) || 
      'https://cdn.shopify.com/extensions/01a0674f-e340-7c39-856d-a810d6687196/judgeme-739/assets/';
    var scriptSrc = baseUrl + 'review_widget.js';

    if (!document.querySelector('script[src="' + scriptSrc + '"]')) {
      var script = document.createElement('script');
      script.type = 'module';
      script.src = scriptSrc;
      document.head.appendChild(script);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', ensureWidgetInit);
  } else {
    ensureWidgetInit();
  }

  // Diagnostic fallback after timeout if Judge.me cannot load
  setTimeout(function() {
    if (!isMounted() && loader) {
      loader.innerHTML = '<p class="adrini-empty-notice">Be the first to write a review.</p>' +
        '<button type="button" class="jm-button jm-button--primary" onclick="window.jdgm && window.jdgm.openWriteReviewModal && window.jdgm.openWriteReviewModal() || (window.location.hash=\'#judgeme\')">WRITE A REVIEW</button>';
    }
  }, 4000);
})();
</script>

<style>
/* ============================================================
   ADRINI LUXURY DESIGN SKIN FOR JUDGE.ME PRODUCT REVIEWS
   Scoped strictly to .adrini-reviews-section and official modal
   ============================================================ */

.adrini-reviews-section {
  width: 100%;
  background: #FFFFFF;
  padding: 36px 0 40px 0;
  border-top: 1px solid #EDE1E3;
  position: relative;
  font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif;
  color: #1A1208;
  box-sizing: border-box;

  /* Global Judge.me CSS Variable Overrides */
  --jdgm-primary-color: #651B24 !important;
  --jdgm-secondary-color: rgba(101, 27, 36, 0.08) !important;
  --jdgm-star-color: #651B24 !important;
  --jdgm-write-review-text-color: #FFFFFF !important;
  --jdgm-write-review-bg-color: #651B24 !important;
  --jdgm-paginate-color: #651B24 !important;
  --jdgm-border-radius: 4px !important;
  --jdgm-reviewer-name-color: #1A1208 !important;
  --jm-review-widget-text-color: #1A1208 !important;
  --jm-color-primary: #651B24 !important;
  --jm-color-star: #651B24 !important;
  --jm-color-border: #EDE1E3 !important;
}

.adrini-reviews-section * {
  box-sizing: border-box;
}

.adrini-reviews-section .adrini-reviews-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
}

/* Header */
.adrini-reviews-section .adrini-reviews-header {
  text-align: center;
  margin-bottom: 24px;
}

.adrini-reviews-section .adrini-reviews-eyebrow {
  font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: #651B24;
  margin-bottom: 8px;
}

.adrini-reviews-section .adrini-reviews-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: 34px;
  font-weight: 400;
  letter-spacing: 0.02em;
  color: #1A1208;
  margin: 0;
  line-height: 1.2;
}

/* Prevent duplicate titles inside the widget */
.adrini-reviews-section .jdgm-rev-widg__title,
.adrini-reviews-section .jm-review-widget-minimal-header__title {
  display: none !important;
}

/* Compact Loading State */
.adrini-reviews-loading {
  text-align: center;
  padding: 24px 0;
  color: #665E5E;
  font-size: 13px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.adrini-spin-dot {
  width: 24px;
  height: 24px;
  border: 2px solid #EDE1E3;
  border-top-color: #651B24;
  border-radius: 50%;
  animation: adriniSpin 0.7s linear infinite;
}

@keyframes adriniSpin {
  to { transform: rotate(360deg); }
}

.adrini-empty-notice {
  font-size: 14px;
  color: #665E5E;
  margin: 0 0 12px 0;
}

/* ============================================================
   JUDGE.ME REVAMP & CLASSIC STYLING
   ============================================================ */

.adrini-reviews-section .jdgm-widget,
.adrini-reviews-section .jm-review-widget {
  max-width: 100% !important;
  font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif !important;
  color: #1A1208 !important;
  padding-block: 0 !important;
}

.adrini-reviews-section .jdgm-rev-widg {
  border: none !important;
  padding: 0 !important;
  margin: 0 !important;
  background: transparent !important;
}

/* ------------------------------------------------------------
   Summary Header Cards & Empty State Cards
   ------------------------------------------------------------ */
.adrini-reviews-section .jdgm-rev-widg__header,
.adrini-reviews-section .jm-review-widget-sidebar-header__sidebar,
.adrini-reviews-section .jm-review-widget-minimal-header {
  background: #FAF8F8 !important;
  border: 1px solid #EDE1E3 !important;
  border-radius: 8px !important;
  padding: 24px 28px !important;
  margin-bottom: 20px !important;
  box-shadow: none !important;
}

.adrini-reviews-section .jdgm-rev-widg__summary-average,
.adrini-reviews-section [class*="average-rating"] {
  font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif !important;
  font-size: 36px !important;
  font-weight: 700 !important;
  color: #651B24 !important;
  line-height: 1 !important;
}

/* Hide redundant secondary empty state in Revamp body when header has empty state */
.adrini-reviews-section .jm-review-widget__body .jdgm-empty-state {
  display: none !important;
}

.adrini-reviews-section .jm-review-widget__body {
  margin-top: 0 !important;
  padding-top: 0 !important;
}

/* Empty State Text */
.adrini-reviews-section .jm-no-reviews-state__text,
.adrini-reviews-section .jdgm-empty-state {
  font-family: Inter, -apple-system, sans-serif !important;
  font-size: 14px !important;
  color: #665E5E !important;
  margin: 0 0 12px 0 !important;
  text-align: center !important;
}

/* ------------------------------------------------------------
   Stars
   ------------------------------------------------------------ */
.adrini-reviews-section .jdgm-star,
.adrini-reviews-section .jm-star,
.adrini-reviews-section [class*="StarRating"] svg,
.adrini-reviews-section [class*="star"] {
  color: #651B24 !important;
  fill: #651B24 !important;
}

.adrini-reviews-section .jdgm-star.jdgm--off {
  color: #EAE2E4 !important;
  fill: #EAE2E4 !important;
}

/* ------------------------------------------------------------
   Buttons & CTAs
   ------------------------------------------------------------ */
.adrini-reviews-section .jdgm-write-rev-link,
.adrini-reviews-section .jdgm-btn,
.adrini-reviews-section .jdgm-submit-rev,
.adrini-reviews-section .jm-button--primary,
.adrini-reviews-section button[class*="write-review"],
.adrini-reviews-section [class*="WriteReviewButton"],
.adrini-reviews-section [data-testid="write-review-button"] {
  background: #651B24 !important;
  background-color: #651B24 !important;
  color: #FFFFFF !important;
  font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif !important;
  font-size: 11px !important;
  font-weight: 600 !important;
  letter-spacing: 0.08em !important;
  text-transform: uppercase !important;
  padding: 12px 24px !important;
  border-radius: 4px !important;
  border: 1px solid #651B24 !important;
  transition: all 0.25s ease !important;
  text-decoration: none !important;
  cursor: pointer !important;
  box-shadow: none !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
}

.adrini-reviews-section .jdgm-write-rev-link:hover,
.adrini-reviews-section .jdgm-btn:hover,
.adrini-reviews-section .jdgm-submit-rev:hover,
.adrini-reviews-section .jm-button--primary:hover,
.adrini-reviews-section button[class*="write-review"]:hover,
.adrini-reviews-section [data-testid="write-review-button"]:hover {
  background: #4A121A !important;
  background-color: #4A121A !important;
  border-color: #4A121A !important;
  color: #FFFFFF !important;
  transform: translateY(-1px) !important;
}

/* ------------------------------------------------------------
   Review Cards & Review Items
   ------------------------------------------------------------ */
.adrini-reviews-section .jdgm-rev,
.adrini-reviews-section .jm-review-item,
.adrini-reviews-section [class*="ReviewItem"],
.adrini-reviews-section [class*="review-item"] {
  background: #FFFFFF !important;
  border: 1px solid #EDE1E3 !important;
  border-radius: 8px !important;
  padding: 20px 22px !important;
  margin-bottom: 14px !important;
  box-shadow: none !important;
  transition: border-color 0.2s ease !important;
}

.adrini-reviews-section .jdgm-rev:hover,
.adrini-reviews-section [class*="ReviewItem"]:hover {
  border-color: #D6C8CA !important;
}

/* Verified Buyer Badge */
.adrini-reviews-section .jdgm-rev__buyer-badge,
.adrini-reviews-section .jm-verified-badge,
.adrini-reviews-section [class*="VerifiedBadge"],
.adrini-reviews-section [class*="verified-badge"] {
  background: #FAF4EB !important;
  color: #651B24 !important;
  border: 1px solid #F0E3D2 !important;
  font-family: Inter, -apple-system, sans-serif !important;
  font-size: 10px !important;
  font-weight: 600 !important;
  text-transform: uppercase !important;
  letter-spacing: 0.06em !important;
  padding: 2px 7px !important;
  border-radius: 20px !important;
}

/* Review Title */
.adrini-reviews-section .jdgm-rev__title,
.adrini-reviews-section [class*="ReviewTitle"],
.adrini-reviews-section [class*="review-title"] {
  font-family: 'Cormorant Garamond', Georgia, serif !important;
  font-size: 19px !important;
  font-weight: 600 !important;
  color: #1A1208 !important;
  margin: 8px 0 6px 0 !important;
  line-height: 1.3 !important;
}

/* Review Body */
.adrini-reviews-section .jdgm-rev__body,
.adrini-reviews-section [class*="ReviewContent"],
.adrini-reviews-section [class*="review-content"] {
  font-family: Inter, -apple-system, sans-serif !important;
  font-size: 14px !important;
  line-height: 1.6 !important;
  color: #4A4242 !important;
}

/* ------------------------------------------------------------
   Pagination / Load More
   ------------------------------------------------------------ */
.adrini-reviews-section .jdgm-paginate__load-more,
.adrini-reviews-section a.jdgm-paginate__load-more,
.adrini-reviews-section [class*="LoadMoreButton"] {
  border: 1.5px solid #651B24 !important;
  color: #651B24 !important;
  background: #FFFFFF !important;
  font-family: Inter, -apple-system, sans-serif !important;
  font-size: 11px !important;
  font-weight: 600 !important;
  text-transform: uppercase !important;
  letter-spacing: 0.08em !important;
  padding: 12px 28px !important;
  border-radius: 4px !important;
  transition: all 0.25s ease !important;
  cursor: pointer !important;
}

.adrini-reviews-section .jdgm-paginate__load-more:hover,
.adrini-reviews-section a.jdgm-paginate__load-more:hover,
.adrini-reviews-section [class*="LoadMoreButton"]:hover {
  background: #651B24 !important;
  color: #FFFFFF !important;
}

/* ============================================================
   OFFICIAL JUDGE.ME WRITE-A-REVIEW POPUP MODAL (REVAMP / V3)
   Luxury ADRINI styling and z-index elevation above Sticky ATC
   ============================================================ */

.jdgm-write-review-modal {
  z-index: 100000 !important;
}

.jdgm-write-review-modal__overlay {
  background: rgba(26, 18, 8, 0.65) !important;
  backdrop-filter: blur(2px) !important;
  -webkit-backdrop-filter: blur(2px) !important;
}

.jdgm-write-review-modal__container {
  z-index: 2 !important;
}

.jdgm-write-review-modal__content {
  background: #FAF8F8 !important;
  border-radius: 8px !important;
  border: 1px solid #EDE1E3 !important;
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.16) !important;
  font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif !important;
  color: #1A1208 !important;
}

.jdgm-write-review-modal__title {
  font-family: 'Cormorant Garamond', Georgia, serif !important;
  font-size: 26px !important;
  font-weight: 500 !important;
  letter-spacing: 0.02em !important;
  color: #1A1208 !important;
}

.jdgm-write-review-modal__intro {
  font-family: Inter, -apple-system, sans-serif !important;
  font-size: 13px !important;
  color: #665E5E !important;
}

.jdgm-write-review-modal__product-title {
  font-family: 'Cormorant Garamond', Georgia, serif !important;
  font-size: 18px !important;
  font-weight: 500 !important;
  color: #1A1208 !important;
}

.jdgm-write-review-modal .jdgm-star {
  color: #651B24 !important;
  fill: #651B24 !important;
}

.jdgm-write-review-modal .jdgm-star.jdgm--off {
  color: #EAE2E4 !important;
  fill: #EAE2E4 !important;
}

.jdgm-write-review-modal__field-label {
  font-family: Inter, -apple-system, sans-serif !important;
  font-size: 12px !important;
  font-weight: 600 !important;
  letter-spacing: 0.04em !important;
  color: #1A1208 !important;
}

.jdgm-write-review-modal__field-input,
.jdgm-write-review-modal textarea.jdgm-write-review-modal__field-input {
  border: 1px solid #EDE1E3 !important;
  border-radius: 4px !important;
  font-family: Inter, -apple-system, sans-serif !important;
  font-size: 14px !important;
  color: #1A1208 !important;
  background: #FFFFFF !important;
}

.jdgm-write-review-modal__field-input:focus,
.jdgm-write-review-modal textarea.jdgm-write-review-modal__field-input:focus {
  border-color: #651B24 !important;
  outline: 1px solid #651B24 !important;
}

.jdgm-write-review-modal__nav-btn-next,
.jdgm-write-review-modal__nav-btn-close {
  background: #651B24 !important;
  color: #FFFFFF !important;
  border: 1px solid #651B24 !important;
  font-family: Inter, -apple-system, sans-serif !important;
  font-size: 11px !important;
  font-weight: 600 !important;
  letter-spacing: 0.08em !important;
  text-transform: uppercase !important;
  border-radius: 4px !important;
  cursor: pointer !important;
  transition: background 0.2s ease !important;
}

.jdgm-write-review-modal__nav-btn-next:hover,
.jdgm-write-review-modal__nav-btn-close:hover {
  background: #4A121A !important;
}

.jdgm-write-review-modal__nav-btn-back {
  background: transparent !important;
  color: #651B24 !important;
  border: 1px solid #EDE1E3 !important;
  font-family: Inter, -apple-system, sans-serif !important;
  font-size: 11px !important;
  font-weight: 600 !important;
  letter-spacing: 0.08em !important;
  text-transform: uppercase !important;
  border-radius: 4px !important;
  cursor: pointer !important;
}

.jdgm-write-review-modal__close-btn {
  outline: none !important;
  border: none !important;
  background: transparent !important;
  cursor: pointer !important;
}

.jdgm-write-review-modal__close-btn:focus {
  outline: none !important;
}

/* ------------------------------------------------------------
   Responsive Breakpoints (Mobile First)
   320px, 360px, 390px, 430px, Tablet, Desktop
   ------------------------------------------------------------ */
@media (max-width: 768px) {
  .adrini-reviews-section {
    padding: 24px 0 28px 0;
  }

  .adrini-reviews-section .adrini-reviews-container {
    padding: 0 16px;
  }

  .adrini-reviews-section .adrini-reviews-title {
    font-size: 26px;
  }

  .adrini-reviews-section .adrini-reviews-header {
    margin-bottom: 20px;
  }

  .adrini-reviews-section .jdgm-rev-widg__header,
  .adrini-reviews-section .jm-review-widget-sidebar-header__sidebar,
  .adrini-reviews-section .jm-review-widget-minimal-header {
    padding: 18px 16px !important;
  }

  .adrini-reviews-section .jdgm-rev {
    padding: 16px 14px !important;
  }

  .adrini-reviews-section .jdgm-write-rev-link,
  .adrini-reviews-section .jm-button--primary {
    width: 100% !important;
    text-align: center !important;
  }
}

@media (max-width: 430px) {
  .adrini-reviews-section .adrini-reviews-title {
    font-size: 24px;
  }
}
</style>

{% schema %}
{
  "name": "Product Reviews",
  "tag": "section",
  "class": "adrini-reviews-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Reviews"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "CUSTOMER REVIEWS"
    }
  ],
  "presets": [
    {
      "name": "Product Reviews"
    }
  ]
}
{% endschema %}
